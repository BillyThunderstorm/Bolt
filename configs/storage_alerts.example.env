# Bolt Storage Alert Configuration
# Copy this file to .env or configs/storage_alerts.env and configure

# =============================================================================
# Email Notifications
# =============================================================================
# Set to your email address to enable email alerts
ALERT_EMAIL=""

# =============================================================================
# SMS Notifications (via email-to-SMS gateway)
# =============================================================================
# Enter your phone number (digits only, no dashes/spaces)
ALERT_PHONE=""

# Your mobile carrier (lowercase, one of: verizon, att, tmobile, sprint, virgin, boost)
CARRIER=""

# Example:
# ALERT_PHONE="5551234567"
# CARRIER="verizon"

# =============================================================================
# Webhook Notifications
# =============================================================================
# Generic JSON webhook URL (for custom integrations)
WEBHOOK_URL=""

# Discord webhook URL (for Discord bot alerts)
DISCORD_WEBHOOK=""

# =============================================================================
# Thresholds (optional, defaults: WARN=80%, CRIT=95%)
# =============================================================================
# STORAGE_THRESHOLD_WARN=80
# STORAGE_THRESHOLD_CRIT=95

# =============================================================================
# Usage Examples
# =============================================================================
#
# For email alerts only:
#   ALERT_EMAIL="billy@example.com"
#
# For SMS via Verizon:
#   ALERT_PHONE="5551234567"
#   CARRIER="verizon"
#
# For Discord alerts:
#   DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."
#
# For all notifications:
#   Set all of the above values
#
# =============================================================================
