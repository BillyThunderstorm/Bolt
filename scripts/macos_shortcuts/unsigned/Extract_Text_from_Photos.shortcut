			<dict>
				<key>InputMode</key>
				<string>as arguments</string>
				<key>Script</key>
				<string>set -euo pipefail
FILES=("$@")
if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "No images received" &gt;&amp;2
  exit 2
fi
"/Users/carter/developer/Bolt/.venv/bin/python3" "/Users/carter/developer/Bolt/scripts/ocr_to_editable.py" --open "${FILES[@]}"
</string>
				<key>Shell</key>
				<string>/bin/zsh</string>
				<key>UUID</key>
