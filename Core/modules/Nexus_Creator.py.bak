import os
import json
from pathlib import Path
from datetime import datetime
from dotenv import load_dotenv

load_dotenv()

# OpenAI-compatible clients for all providers
try:
    from openai import OpenAI
except ImportError:
    print("pip install openai")
    # Handle gracefully

class NexusCreator:
    def __init__(self):
        self.xai_api_key = os.getenv("XAI_API_KEY")
        self.grok_model = os.getenv("GROK_MODEL", "grok-4.2 reasoning")  # or grok-4.1-fast for cheaper
        self.ollama_base_url = os.getenv("OLLAMA_BASE_URL", "http://localhost:11434/v1")
        self.ollama_model = os.getenv("OLLAMA_MODEL", "llama3.1:8b")  # Change as needed
        self.gemini_key = os.getenv("GEMINI_API_KEY")  # Existing fallback

        # Default routing: Ollama heavy
        self.preferred = "ollama"

    def _get_client(self, provider: str):
        if provider == "ollama":
            return OpenAI(base_url=self.ollama_base_url, api_key="ollama")  # Dummy key
        elif provider == "grok" and self.xai_api_key:
            return OpenAI(api_key=self.xai_api_key, base_url="https://api.x.ai/v1")
        elif provider == "gemini":
            # Your existing Gemini client code here
            pass
        raise ValueError(f"Provider {provider} not configured")

    def _should_use_grok(self, task_type: str, complexity: str = "medium") -> bool:
        """Smart routing: Grok only for high-value tasks."""
        high_value_tasks = {"strategy", "product_testing", "sponsor", "decision", "deep_analysis", "career"}
        return (
            complexity == "high" or 
            task_type in high_value_tasks or 
            (self.xai_api_key and not self._is_ollama_healthy())
        )

    def _is_ollama_healthy(self) -> bool:
        """Quick check if local Ollama is running."""
        try:
            import requests
            resp = requests.get(self.ollama_base_url.replace("/v1", "/api/tags"), timeout=2)
            return resp.status_code == 200
        except:
            return False

    def consult(self, topic: str, context: str = None, task_type: str = "general", complexity: str = "medium"):
        """Main entry point — Ollama heavy, Grok occasional."""
        provider = "grok" if self._should_use_grok(task_type, complexity) else "ollama"
        
        try:
            client = self._get_client(provider)
            model = self.grok_model if provider == "grok" else self.ollama_model
            
            system_prompt = self._build_system_prompt()
            user_prompt = self._build_user_prompt(topic, context)
            
            response = client.chat.completions.create(
                model=model,
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                temperature=0.7,
                max_tokens=1200 if provider == "grok" else 2000,  # Ollama can be more generous
            )
            
            advice = response.choices[0].message.content.strip()
            self._log_advice(topic, advice, provider, model)
            
            return {
                "advice": advice,
                "provider": provider,
                "model": model,
                "task_type": task_type
            }
            
        except Exception as e:
            print(f"{provider.capitalize()} error: {e}. Falling back...")
            # Chain: Ollama → Gemini → Templates
            if provider != "ollama":
                return self.consult(topic, context, task_type, complexity)  # Retry with Ollama
            # Final Gemini or template fallback here...
            return {"advice": "Fallback template response...", "provider": "fallback"}

    def _build_system_prompt(self) -> str:
        brain_path = Path("Core/bolt_brain.md")
        brain = brain_path.read_text(encoding="utf-8")[:3000] if brain_path.exists() else "Billy's creator profile."
        return f"""You are Nexus, Billy's strategic AI teammate for content creation, product testing (Amazon Influencer, tech, skincare), gaming, and career growth.
Creator brain: {brain}
Be actionable, specific, and tie everything to M-tier progress, ML ranking, and multi-platform promotion."""

    def _build_user_prompt(self, topic: str, context: str = None) -> str:
        return f"Topic: {topic}\nAdditional context: {context or 'None'}\nProvide detailed strategy, examples, hooks, testing frameworks, and next 3 actions."

    def _log_advice(self, topic: str, advice: str, provider: str, model: str):
        log_path = Path("Data/data/nexus_advice.jsonl")
        log_path.parent.mkdir(parents=True, exist_ok=True)
        entry = {
            "timestamp": datetime.now().isoformat(),
            "topic": topic,
            "provider": provider,
            "model": model,
            "advice": advice[:500]  # Truncate for log
        }
        with log_path.open("a", encoding="utf-8") as f:
            f.write(json.dumps(entry) + "\n")

    # Extend similarly for optimize_caption, suggest_next_content, etc.