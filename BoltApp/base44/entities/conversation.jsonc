{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The title or subject of this conversation"
    },
    "lastMessageAt": {
      "type": "date-time",
      "description": "When the last message was sent in this conversation"
    }
  },
  "required": ["title"]
}
