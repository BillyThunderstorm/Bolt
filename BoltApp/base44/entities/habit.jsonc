{
  "name": "Habit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The habit name"
    },
    "frequency": {
      "type": "string",
      "enum": ["daily", "weekly"],
      "default": "daily"
    },
    "currentStreak": {
      "type": "integer",
      "default": 0
    },
    "longestStreak": {
      "type": "integer",
      "default": 0
    }
  },
  "required": ["name"]
}
