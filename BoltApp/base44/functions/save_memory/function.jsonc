{
  "name": "save_memory",
  "description": "Save a new memory or fact for later recall. Use this to store information about the user's preferences, facts they've shared, goals, relationships, and other important details.",
  "args_schema": {
    "type": "object",
    "properties": {
      "category": { "type": "string", "description": "Category: 'facts', 'preferences', 'goals', 'relationships', 'projects'" },
      "content": { "type": "string", "description": "The memory or fact to store" },
      "importance": { "type": "string", "enum": ["low", "medium", "high"], "description": "Importance level (default: medium)" }
    },
    "required": ["category", "content"]
  },
  "return_schema": { "type": "object" }
}
