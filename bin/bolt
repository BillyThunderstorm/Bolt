#!/usr/bin/env python3
"""
Bolt CLI — single entry point for every Bolt script and command.

Preferred (shortest) usage — after one-time `uv sync` + shell alias:

    bolt                          # list subcommands
    bolt verify                   # check the install
    bolt recordings               # process latest recordings
    bolt thumbnails --dry-run
    bolt nexus "How do I title my clips?"
    bolt briefing --send
    bolt launch                   # start the bot (Core/launch.py)
    bolt test
    bolt reindex                  # rebuild the Vector DB

From the repo (no alias needed):

    uv run bolt verify
    uv run bolt launch

Fallbacks (always work without the installable entry point):

    uv run python bin/bolt verify
    python3 bin/bolt verify       # uses shebang / current interpreter

One-time shell setup (~/.zshrc) so `bolt` works from anywhere:

    alias bolt='/Users/carter/developer/Bolt/.venv/bin/bolt'

Then `source ~/.zshrc`. The alias hits the console script installed by
`uv sync` (package bolt_cli → project.scripts), which always uses the
project lockfile Python + deps.

Setup wizard (first-time use):

    bolt setup
    # or: uv run bolt setup

> `uv sync` creates .venv from uv.lock + .python-version. You do not need
> to `source .venv/bin/activate` for normal CLI use. Install uv from
> https://docs.astral.sh/uv/ if needed.

Subcommands map 1:1 onto the scripts in `scripts/`
(their hyphenated names match the script basenames). The wrapper does
the sys.path bootstrap once, then exec's the target script with all
remaining args passed through. This is faster and easier to remember
than typing the full path to every script.

The wrapper itself is intentionally tiny (no imports of Bolt's source
code) so it works even if the source tree is broken. The installable
shim is bolt_cli/ (see pyproject.toml [project.scripts]).
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

# Resolve the repo root from this file's location (bin/bolt -> repo root is
# parents[1]). Don't depend on _paths.py — the wrapper should work even if
# the source tree is in a half-broken state.
REPO_ROOT = Path(__file__).resolve().parents[1]
SCRIPTS_DIR = REPO_ROOT / "scripts"
CORE_DIR = REPO_ROOT / "Core"
VENV_PYTHON = REPO_ROOT / ".venv" / "bin" / "python3"

# Subcommand -> relative script path (in scripts/).
# Multiple aliases are allowed. Subcommands that are NOT just script
# passthroughs (like "launch", "test", "setup") are handled specially.
SUBCOMMANDS: dict[str, str] = {
    # Script passthroughs (script name with no .py and lowercase).
    # The wrapper looks up the actual file by lowercased name.
    "verify": "verify.py",
    "recordings": "process_recordings.py",
    "auto_clip_twitch": "auto_clip_twitch.py",
    "auto-clip-twitch": "auto_clip_twitch.py",
    "highlights": "make_twitch_highlights.py",
    "twitch_highlights": "make_twitch_highlights.py",
    "briefing": "daily_briefing.py",
    "briefings": "daily_briefing.py",
    "thumbnails": "generate_thumbnails.py",
    "calendar": "generate_calendar.py",
    "nexus": "nexus_advice.py",
    "advice": "nexus_advice.py",
    "performance": "performance_baseline.py",
    "site": "site_data_writer.py",
    "weekly": "weekly_analysis.py",
    "monthly": "weekly_analysis.py",
    "log_perf": "log_clip_performance.py",
    "log_performance": "log_clip_performance.py",
    "monitor_titles": "monitor_title_results.py",
    "test_titles": "test_title_upgrade_10_clips.py",
    "vods": "twitch_vod_downloader.py",
    "vod_download": "twitch_vod_downloader.py",
    "twitch_token": "get_twitch_token.py",
    "twitch_bot_token": "get_twitch_bot_token.py",
    "tiktok_token": "get_tiktok_token.py",
    "youtube_token": "get_youtube_token.py",
    "sync_tiktok_stats": "sync_tiktok_stats.py",
    "sync_tiktok": "sync_tiktok_stats.py",
    "tiktok_stats": "sync_tiktok_stats.py",
    "sync_youtube_stats": "sync_youtube_stats.py",
    "sync_youtube": "sync_youtube_stats.py",
    "youtube_stats": "sync_youtube_stats.py",
    "send": "send_notification.py",
    "notify": "send_notification.py",
    "refresh_memory": "refresh_memory_index.py",
    "refresh_vector_db": "modules/Local_Vector_DB.py",
    "vector_db": "modules/Local_Vector_DB.py",
    "reindex": "modules/Local_Vector_DB.py",
    "filter_backlog": "Filter_Backlog.py",
    "watch": "Watcher.py",
    "bot_with_twitch": "bot_with_twitch.py",
    "clip_dedupe": "clip_deduplicator.py",
    "make_highlights": "make_highlights.py",
    "layout": "check_layout.py",
    "check_layout": "check_layout.py",
}

# Content-manager subcommands handled by Core/modules/Content_Manager.py
MANAGER_COMMANDS = {
    "manage",
    "store",
    "social",
    "sponsors",
    "business",
    "advance",
    "morning",
    "good-morning",
    "goodmorning",
}

HELP_TEXT = """
Bolt — single-command access to every Bolt script and command.

Usage:  bolt <subcommand> [args...]

Script subcommands (each maps to scripts/X.py):
  verify                  Run the install/setup verifier
  recordings [mode]       Process existing recordings (default: latest)
  auto_clip_twitch        Auto-clip highlights from Twitch VODs
  highlights              Compile top clips into a Twitch highlight reel
  briefing [--print|--speak]
                          Generate daily briefing (optional speak summary)
  thumbnails [args]       Generate JPG thumbnails for clips
  calendar                Generate ICS calendar feeds
  nexus "<question>"      Ask Nexus for content strategy advice
  performance             Run a performance baseline
  site [--push]           Write site-data.json
  weekly                  Generate weekly performance insights
  log_perf [args]         Log a clip's performance
  monitor_titles          Summarize title-generation signals
  test_titles             Run the 10-clip title-upgrade smoke test
  vods                    Download Twitch VOD samples
  twitch_token            Get a Twitch chat token
  twitch_bot_token        Get a Twitch bot chat token
  tiktok_token            Get a TikTok OAuth token (needs video.list for stats)
  youtube_token           Get a YouTube OAuth token (Data API readonly)
  sync_tiktok_stats       Pull TikTok views/likes into performance log
  sync_youtube_stats      Pull YouTube/Shorts views/likes into performance log
  send "<msg>"            Send an SMS / email notification
  refresh_memory          Rebuild the clip memory index (Data/memory_index.json)
  refresh_vector_db        Rebuild the Vector DB for Nexus
                          (alias: vector_db, reindex) — lives in Core/modules/
  vector_db                Short alias for refresh_vector_db
  reindex                  Short alias for refresh_vector_db
  filter_backlog          Move low-scoring clips to clips/_low_score/
  watch                   Watch the recordings folder for new files
  layout [--quiet|--json] Report any files misplaced at the repo root (no moves)

Content manager / creator business (Core/modules/Content_Manager.py):
  manage add|list|note|draft|next|status
  store add|list|feature-next
  social status|package|queue
  sponsors find|pitch|log|next
  business lesson|next
  advance next
  morning [--quiet]       Good Morning Bolt spoken daily briefing

Voice (listen → interpret → speak via Core/bolt_live_voice.py):
  voice [--text|--status|--clear|--once "…"]
                          Hands-free conversation (mic + TTS)
  talk ["prompt"]         Alias for voice (optional one-shot prompt)
  say "message"           Speak a line out loud via Bolt_Voice
  briefing --speak        Generate daily briefing and speak a short summary
  storage [monitor|rotate|optimize|status]
                          Disk + media folder health (fixed paths under media/)
                          status=sizes only; monitor=alerts; rotate/optimize=cleanup
  budget | api-usage      xAI spend this month, soft cap, budget mode
  day [--decide|--voice|--quiet|--open|--process]
                          Morning kickoff; --decide → queue decide (default offer on TTY)
  stats [status|sync|tiktok|youtube] [--dry-run]
                          Social performance pull readiness + TikTok/YouTube sync

Direction-finding researcher (Core/modules/Researcher.py):
  research [status|questions|candidates|pending|log|add|note|c5]
                          Profile-aware research role (C5/C6/C7 gates + log)
                          c5 keep|drop "Name"  — record your C5 decision
                          add "Name" --platform … --summary … --why …

Creator Command Center (Core/modules/Command_Center.py):
  mission [status|checkin|playbook|list|show|start|next]
                          Turn a goal into a printable mission briefing
  command-center …        Alias for mission
  ccc …                   Short alias for mission

Post queue / peak posting (Core/modules/Peak_Hour_Notifier.py):
  queue [status|list|next|decide|clean|approve|…]
                          Ready-to-post queue (Data/ready_to_post.json)
                          NOT media/vertical_clips/ — that folder is videos only
  queue decide            Interactive: open / approve / hold / post (easiest)
  queue next [--open]     Show next postable clip card
  queue package [id]      Manual upload package (paste-ready captions)
  queue clean             Clear ghost rows (ready but file missing)
  approve [clip_id]       Approve next (or named) clip for peak auto-post
  postnow [clip_id]       Publish immediately (alias: post-now)
  mark-posted [clip_id]   After manual upload (alias: queue mark-posted)
  dontpost [clip_id] <why>
                          Hold a clip and record the reason
  tiktok-post [--demo|--live]
                          Compliant Post-to-TikTok web UI (audit demo)
                          (aliases: post-ui, tiktok_post)

Built-in subcommands (not script passthroughs):
  setup                   Finite setup check (config + keys); exits when done
  launch                  Start live mode (folder watch + optional OBS)
  test [testmodule]       Run the full test suite (or a specific test module)
  help                    Show this message
  version                 Show Bolt's repo path and Python version

Setup:
  Add to your shell rc (so you can just type 'bolt <thing>'):
    alias bolt='/Users/carter/developer/Bolt/.venv/bin/bolt'
"""


def find_script(name: str) -> Path | None:
    """Look up a subcommand name in SUBCOMMANDS. Return the absolute path
    to the script file, or None if the subcommand isn't a known script.

    Entries starting with "modules/" resolve under Core/ (e.g. Core/modules/X.py);
    everything else resolves under scripts/.
    """
    if name in SUBCOMMANDS:
        rel = SUBCOMMANDS[name]
        base = CORE_DIR if rel.startswith("modules/") else SCRIPTS_DIR
        return base / rel
    return None


def main() -> int:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        return 0

    if args[0] in ("-V", "--version", "version"):
        print(f"bolt {REPO_ROOT}")
        print(f"  python  {sys.executable}")
        print(f"  venv    {VENV_PYTHON}  ({'exists' if VENV_PYTHON.exists() else 'NOT FOUND'})")
        return 0

    subcommand, *rest = args
    py = str(VENV_PYTHON if VENV_PYTHON.exists() else sys.executable)

    # Built-in: launch
    if subcommand == "launch":
        cmd = [py, "Core/launch.py"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT))

    # Built-in: test
    if subcommand == "test":
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}:{SCRIPTS_DIR.parent}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        test_args = rest if rest else ["discover", "-s", "Data/tests", "-t", "."]
        cmd = [py, "-m", "unittest"] + test_args
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: setup — finite wizard/check pass. Does NOT start live watch.
    # (Historically this handed off to bot.py and looked like a hang forever.)
    if subcommand == "setup":
        cmd = [py, "Core/launch.py", "setup"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT))

    # Built-in: daily content kickoff (optionally → queue decide / voice)
    if subcommand in ("day", "today", "kickoff", "start-day", "morning-flow"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        cmd = [py, str(CORE_DIR / "bolt_day.py")] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: social stats status + TikTok/YouTube performance sync
    if subcommand in ("stats", "social-stats", "social_stats", "performance-sync"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        cmd = [py, "-m", "modules.Social_Stats"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: API budget / usage (soft cap + xai_usage.jsonl)
    if subcommand in ("budget", "api-usage", "api_usage", "xai-usage", "llm-budget"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        do_test = "--test-alert" in rest or "--test" in rest
        # Pass flag into -c script via env (inner python argv is only -c)
        env["BOLT_BUDGET_TEST_ALERT"] = "1" if do_test else "0"
        script = r'''
from modules.LLM_Budget import describe_policy, llm_mode, briefing_provider_preference
from modules.XAI_Usage import status_dict, monthly_cap_usd
from modules.Bolt_Alerts import channels_status
import json, os
print("Bolt LLM / xAI budget")
print("─" * 40)
print(describe_policy())
print(f"mode:              {llm_mode()}")
print(f"briefing provider: {briefing_provider_preference()}")
print(f"monthly cap USD:   {monthly_cap_usd() or 'unlimited'}")
print()
print(json.dumps(status_dict(), indent=2))
print()
print("Alert channels (no Discord):")
print(json.dumps(channels_status(), indent=2))
if os.getenv("BOLT_BUDGET_TEST_ALERT") == "1":
    from modules.Bolt_Alerts import notify
    print()
    print("Sending test alert (Mac + SMS + email)…")
    result = notify(
        "Bolt budget alert test — if you got this, SMS/email/Mac are working.",
        title="Bolt test",
        subject="Bolt alert test",
        email_body=(
            "Bolt budget alert test.\n\n"
            "If you see this email, SMTP is working.\n"
            "SMS uses the same path via your carrier gateway.\n"
        ),
    )
    print("Results:", result)
    if not result.get("email") or not result.get("sms"):
        print(
            "Tip: check Gmail → Sent and Spam. "
            "For SMS, AT&T can delay 1–5 min; ensure SMTP App Password is correct."
        )
'''
        cmd = [py, "-c", script]
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: voice / talk / say — hands-free listen → interpret → speak
    if subcommand in ("voice", "talk", "live-voice", "live_voice", "say"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand == "say":
            voice_args = ["--say"] + rest
        else:
            voice_args = list(rest)
        cmd = [py, str(CORE_DIR / "bolt_live_voice.py")] + voice_args
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: storage monitor / rotation / optimization (canonical media/ paths)
    if subcommand in ("storage", "disk", "media-rotation", "storage-monitor"):
        action = rest[0] if rest else "status"
        extra = rest[1:] if rest else []
        os.chdir(REPO_ROOT)
        if action in ("status", "report", "sizes"):
            # Quick sizes-only report (no auto-clean, no notifications)
            script = f'''
from pathlib import Path
import shutil
root = Path({str(REPO_ROOT)!r})
media = root / "media"
for name in ("Recordings", "clips", "vertical_clips", "output"):
    p = media / name
    if not p.exists():
        print(f"  {{name}}: missing ({{p}})")
        continue
    total = sum(f.stat().st_size for f in p.rglob("*") if f.is_file())
    print(f"  {{name}}: {{total/1024**3:.2f}}GB  ({{p}})")
u = shutil.disk_usage(root)
print(f"  Disk: {{100*u.used/u.total:.0f}}% used, {{u.free/1024**3:.1f}}GB free")
'''
            cmd = [py, "-c", script]
            rc = subprocess.call(cmd, cwd=str(REPO_ROOT))
            # Speak a short storage line when auto-speak is on
            env = os.environ.copy()
            env["PYTHONPATH"] = f"{CORE_DIR}" + (
                f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
            )
            speak_script = '''
try:
    from modules.Intent_Router import _action_storage
    from modules.Bolt_Voice import speak_result
    speak_result(_action_storage())
except Exception:
    pass
'''
            subprocess.call([py, "-c", speak_script], cwd=str(REPO_ROOT), env=env)
            return rc
        if action in ("monitor", "check"):
            cmd = ["bash", str(SCRIPTS_DIR / "storage_monitor.sh")] + extra
            return subprocess.call(cmd, cwd=str(REPO_ROOT))
        if action in ("rotate", "rotation"):
            cmd = ["bash", str(SCRIPTS_DIR / "media_rotation.sh")] + (extra or ["--dry-run"])
            return subprocess.call(cmd, cwd=str(REPO_ROOT))
        if action in ("optimize", "optimisation", "cleanup"):
            cmd = ["bash", str(SCRIPTS_DIR / "storage_optimization.sh")] + (
                extra or ["--dry-run", "--skip-dedup", "--skip-compress"]
            )
            return subprocess.call(cmd, cwd=str(REPO_ROOT))
        print(f"bolt storage: unknown action '{action}'", file=sys.stderr)
        print("  Use: status | monitor | rotate | optimize", file=sys.stderr)
        return 2

    # Content manager / Good Morning Bolt
    if subcommand in MANAGER_COMMANDS or subcommand.startswith("manage"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        # Map friendly CLI to Content_Manager main() argv
        cm_args: list[str] = []
        if subcommand in ("morning", "good-morning", "goodmorning"):
            cm_args = ["morning"] + rest
        elif subcommand == "manage":
            cm_args = rest if rest else ["status"]
        elif subcommand == "store":
            # store add|list|feature-next -> store-add|store-list|store-feature-next
            if not rest:
                cm_args = ["store-list"]
            else:
                action, *tail = rest
                mapping = {
                    "add": "store-add",
                    "list": "store-list",
                    "feature-next": "store-feature-next",
                    "feature": "store-feature-next",
                }
                cm_args = [mapping.get(action, action)] + tail
        elif subcommand == "social":
            if not rest:
                cm_args = ["social-status"]
            else:
                action, *tail = rest
                mapping = {
                    "status": "social-status",
                    "package": "social-package",
                    "queue": "social-queue",
                }
                cm_args = [mapping.get(action, action)] + tail
        elif subcommand == "sponsors":
            if not rest:
                cm_args = ["sponsors-find"]
            else:
                action, *tail = rest
                mapping = {
                    "find": "sponsors-find",
                    "pitch": "sponsors-pitch",
                    "log": "sponsors-log",
                    "next": "sponsors-next",
                }
                cm_args = [mapping.get(action, action)] + tail
        elif subcommand == "business":
            if not rest:
                cm_args = ["business-lesson"]
            else:
                action, *tail = rest
                mapping = {
                    "lesson": "business-lesson",
                    "next": "business-next",
                }
                cm_args = [mapping.get(action, action)] + tail
        elif subcommand == "advance":
            cm_args = ["advance-next"] + rest
        else:
            cm_args = [subcommand] + rest

        cmd = [py, "-m", "modules.Content_Manager"] + cm_args
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: researcher role (direction-finding)
    if subcommand in ("research", "researcher"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        cmd = [py, "-m", "modules.Researcher"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: Creator Command Center (mission briefings)
    if subcommand in ("mission", "command-center", "command_center", "ccc"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        cmd = [py, "-m", "modules.Command_Center"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: TikTok Post UI (audit-compliant export screen)
    if subcommand in (
        "tiktok-post",
        "tiktok_post",
        "post-ui",
        "post_ui",
        "tiktok-ui",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        cmd = [py, "-m", "modules.TikTok_Post_UI"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: ready-to-post queue / peak-hour approval
    # State: Data/ready_to_post.json  |  videos: media/vertical_clips/
    QUEUE_COMMANDS = {
        "queue",
        "postqueue",
        "post-queue",
        "ready-queue",
        "approve",
        "postnow",
        "post-now",
        "dontpost",
        "dont-post",
        "hold-clip",
        "mark-posted",
        "markposted",
        "mark_posted",
    }
    if subcommand in QUEUE_COMMANDS:
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        # Map short top-level verbs onto Peak_Hour_Notifier actions.
        if subcommand in ("queue", "postqueue", "post-queue", "ready-queue"):
            q_args = rest if rest else ["status"]
        elif subcommand == "approve":
            q_args = ["approve"] + rest
        elif subcommand in ("postnow", "post-now"):
            q_args = ["post-now"] + rest
        elif subcommand in ("dontpost", "dont-post", "hold-clip"):
            q_args = ["reject"] + rest
        elif subcommand in ("mark-posted", "markposted", "mark_posted"):
            # Top-level alias: bolt mark-posted [id]  →  queue mark-posted
            q_args = ["mark-posted"] + rest
        else:
            q_args = [subcommand] + rest
        cmd = [py, "-m", "modules.Peak_Hour_Notifier"] + q_args
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: intelligence/status
    if subcommand in ("intelligence", "status"):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        script = '''from modules.Think_Learn_Decide import ThinkLearnDecideEngine
from modules.Config_Loader import load_config
from modules.Local_Vector_DB import LocalVectorDB
from modules.Nexus_Creator import NexusCreator

config = load_config()
engine = ThinkLearnDecideEngine(config)

print('✅ Decision Engine: Ready')
print('   • think_and_propose:', hasattr(engine, 'think_and_propose'))
print('   • _get_nexus_insight:', hasattr(engine, '_get_nexus_insight'))
print('   • log_nexus_insight:', hasattr(engine, 'log_nexus_insight'))

try:
    db = LocalVectorDB()
    print('✅ Vector DB: Ready')
except Exception as e:
    print('❌ Vector DB:', e)

try:
    nexus = NexusCreator()
    print('✅ Nexus Creator: Ready')
    print('   Preferred provider:', getattr(nexus, 'preferred_provider', 'unknown'))
except Exception as e:
    print('❌ Nexus:', e)

print()
print('System is fully upgraded.')
'''
        cmd = [py, "-c", script]
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Script passthrough
    script = find_script(subcommand)
    if script is None:
        print(f"bolt: unknown subcommand '{subcommand}'", file=sys.stderr)
        print(f"  Run 'bolt help' for the full list of subcommands.", file=sys.stderr)
        return 2

    if not script.exists():
        print(f"bolt: script not found: {script}", file=sys.stderr)
        return 1

    # Exec the script with the rest of the args, using the venv Python so
    # `dotenv` and `Pillow` are available.
    cmd = [str(VENV_PYTHON if VENV_PYTHON.exists() else sys.executable), str(script)] + rest
    os.chdir(REPO_ROOT)
    return subprocess.call(cmd, cwd=str(REPO_ROOT))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl+C during a long setup/watch/recordings run — exit cleanly
        # instead of dumping a multi-frame subprocess.wait traceback.
        print("\nbolt: stopped by user.", file=sys.stderr)
        sys.exit(130)
