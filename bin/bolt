        "log_perf_status",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "log-perf-status",
            "log_perf_status",
        ) and not rest:
            rest = ["status"]
        # Bare → status; engine flags without action → run
        if not rest:
            rest = ["status"]
        elif rest[0] not in ("status", "list", "run", "-h", "--help") and rest[0].startswith("-"):
            rest = ["run"] + rest
        cmd = [py, "-m", "modules.Log_Perf"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)


    # Built-in: repo-root layout audit (Layout_Check; soft-fail; READY 21 Oct 2026)
    # Former thin SCRIPT_MAP layout/check_layout (no soft-fail status/list/run).
    # Report-only — never moves files. Distinct from READY bolt doctor / verify.
    if subcommand in (
        "layout",
        "check-layout",
        "check_layout",
        "layout-status",
        "layout_status",
        "layout-check",
        "layout_check",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "layout-status",
            "layout_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Layout_Check"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: repo-root layout migrator (Migrate_Layout; soft-fail; READY 21 Oct 2026)
    # Companion to READY bolt layout (report-only). Dry-run default; --apply moves,
    # never overwrites, logs to Data/layout_moves.jsonl; undo puts the last run back.
    if subcommand in (
        "migrate-layout",
        "migrate_layout",
        "layout-migrate",
        "layout_migrate",
        "migrate-status",
        "migrate_status",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "migrate-status",
            "migrate_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Migrate_Layout"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: quick health check (Health_Check; soft-fail; READY 21 Oct 2026)
    # Engine scripts/health_check.py. Full audit: bolt doctor.
    if subcommand in (
        "health",
        "health-check",
        "health_check",
        "health-status",
        "health_status",
        "system-health",
        "system_health",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "health-status",
            "health_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Health_Check"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: SHA256 hash dedupe scan (Hash_Dedupe; soft-fail; READY)
    # Former thin SCRIPT_MAP clip_dedupe (parents[3] wrong root). Distinct from
    # READY pipeline Clip_Deduplicator (pHash / Data/seen_clips.json).
    if subcommand in (
        "clip-dedupe",
        "clip_dedupe",
        "hash-dedupe",
        "hash_dedupe",
        "dedupe-status",
        "dedupe_status",
        "sha-dedupe",
        "sha_dedupe",
        "hash-dedupe-status",
        "hash_dedupe_status",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "dedupe-status",
            "dedupe_status",
            "hash-dedupe-status",
            "hash_dedupe_status",
        ) and not rest:
            rest = ["status"]
        # --scan / --check paths are relative to where William typed the command,
        # not the repo (we chdir below).
        _caller = os.getcwd()
        rest = list(rest)
        for _i in range(len(rest) - 1):
            if rest[_i] in ("--scan", "--check"):
                _p = os.path.expanduser(rest[_i + 1])
                if not os.path.isabs(_p) and os.path.exists(os.path.join(_caller, _p)):
                    rest[_i + 1] = os.path.abspath(os.path.join(_caller, _p))
        cmd = [py, "-m", "modules.Hash_Dedupe"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: Bolt system prompt (Bolt_Personality). LLM_Handler, not Gemini.
    # Canonical: Data/context/bolt-personality.md. Soft-fail if file or model missing.
    if subcommand in (
        "personality",
        "bolt-personality",
        "bolt_personality",
        "personality-status",
        "personality_status",
        "persona",
        "load-personality",
        "load_personality",
        "load-bolt-personality",
        "load_bolt_personality",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "personality-status",
            "personality_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Bolt_Personality"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: Photo / handwriting OCR (Photo_OCR; soft-fail; READY)
    if subcommand in (
        "photo-ocr",
        "photo_ocr",
        "photo-ocr-status",
        "photo_ocr_status",
        "ocr-photos",
        "ocr_photos",
        "vision-ocr",
        "vision_ocr",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "photo-ocr-status",
            "photo_ocr_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Photo_OCR"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: clip compression (Video_Compress; ffmpeg-full first; soft-fail; READY)
    if subcommand in (
        "compress",
        "video-compress",
        "video_compress",
        "handbrake",
        "compress-videos",
        "compress_videos",
        "compress-status",
        "compress_status",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        if subcommand in (
            "compress-status",
            "compress_status",
        ) and not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.Video_Compress"] + (rest if rest else ["status"])
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: local title A/B trainer (AI_Title_Generator; soft-fail)
    if subcommand in (
        "titles",
        "title",
        "title-train",
        "title_train",
        "train-titles",
        "train_titles",
        "ab-titles",
        "ab_titles",
    ):
        env = os.environ.copy()
        env["PYTHONPATH"] = f"{CORE_DIR}" + (
            f":{env['PYTHONPATH']}" if env.get("PYTHONPATH") else ""
        )
        # Bare `bolt titles` → status (safe)
        if not rest:
            rest = ["status"]
        cmd = [py, "-m", "modules.AI_Title_Generator"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Built-in: merge local .py sources into one dump (Core/merge_py.py; soft-fail)
    if subcommand in (
        "merge-py",
        "merge_py",
        "mergepy",
        "merge-sources",
        "merge_sources",
    ):
        env = os.environ.copy()
        merge_script = CORE_DIR / "merge_py.py"
        if not merge_script.exists():
            print(f"Merge unavailable: missing {merge_script}", file=sys.stderr)
            return 0
        # Bare `bolt merge-py` → status (safe; write needs explicit run)
        if not rest:
            rest = ["status"]
        cmd = [py, str(merge_script)] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

    # Script passthrough
    script = find_script(subcommand)
    if script is None:
        global _TYPO_GUARD
        if not _TYPO_GUARD:
            resolved, suggestions = _resolve_unknown_subcommand(subcommand)
            if resolved and resolved != subcommand:
                print(
                    f"bolt: running '{resolved}' (you typed '{subcommand}')",
                    file=sys.stderr,
                )
                _TYPO_GUARD = True
                try:
                    sys.argv[1] = resolved
                    return main()
                finally:
                    _TYPO_GUARD = False
            print(f"bolt: unknown subcommand '{subcommand}'", file=sys.stderr)
            if suggestions:
                print(
                    "  did you mean: " + ", ".join(suggestions),
                    file=sys.stderr,
                )
            else:
                print(
                    "  Run 'bolt help' for commands, or 'bolt word' to look one up.",
                    file=sys.stderr,
                )
            print(
                "  Run 'bolt help' for the full list of subcommands.",
                file=sys.stderr,
            )
            return 2
        print(f"bolt: unknown subcommand '{subcommand}'", file=sys.stderr)
        print(f"  Run 'bolt help' for the full list of subcommands.", file=sys.stderr)
        return 2

    if not script.exists():
        print(f"bolt: script not found: {script}", file=sys.stderr)
        return 1

    # Exec the script with the rest of the args, using the venv Python so
    # `dotenv` and `Pillow` are available.
    cmd = [str(VENV_PYTHON if VENV_PYTHON.exists() else sys.executable), str(script)] + rest
    os.chdir(REPO_ROOT)
    return subprocess.call(cmd, cwd=str(REPO_ROOT))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl+C during a long setup/watch/recordings run — exit cleanly
        # instead of dumping a multi-frame subprocess.wait traceback.
        print("\nbolt: stopped by user.", file=sys.stderr)
        sys.exit(130)
