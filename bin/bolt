            "error-recovery-status",
            "error_recovery_status",
        ) and not rest:
            rest = ["status"]
        if subcommand == "quarantine" and rest and rest[0] not in (
            "status", "list", "run", "summary", "report", "quarantine", "restore", "clear",
        ):
            rest = ["quarantine"] + list(rest)
        if not rest:
            rest = ["status"]
        # quarantine FILE is relative to where William typed the command.
        _caller = os.getcwd()
        rest = list(rest)
        if rest and rest[0] == "quarantine":
            for _i in range(1, len(rest)):
                _a = rest[_i]
                if _a.startswith("-") or (_i > 1 and rest[_i - 1] == "--reason"):
                    continue
                _p = os.path.expanduser(_a)
                if not os.path.isabs(_p) and os.path.exists(os.path.join(_caller, _p)):
                    rest[_i] = os.path.abspath(os.path.join(_caller, _p))
        cmd = [py, "-m", "modules.Error_Recovery"] + rest
        os.chdir(REPO_ROOT)
        return subprocess.call(cmd, cwd=str(REPO_ROOT), env=env)

