# Bolt environment config template
# Copy to .env and fill in only the services you want to use.
# Never commit real API keys, tokens, passwords, or webhook URLs.

# OBS WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Twitch
TWITCH_CHANNEL=BillyandRandy
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_BOT_NAME=

# Streamlabs
STREAMLABS_SOCKET_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=

# Optional/legacy AI hooks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice
Bolt_VOICE=Oliver (Enhanced)
Bolt_VOICE_MUTE=false
