# Bolt environment config template
# Copy to .env and fill in only the services you want to use.
# Never commit real API keys, tokens, passwords, or webhook URLs.

# OBS WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Twitch
TWITCH_CHANNEL=ItsSimplyBilly
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_BOT_NAME=

# Streamlabs
STREAMLABS_SOCKET_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=
CAPTAIN_HOOK_WEBHOOK_URL=

# LLM provider selection (chat / !Bolt — separate from Nexus)
# openai  = use OpenAI (default, safe)
# xai     = use Grok via xAI API (paid usage; SuperGrok app sub ≠ free API)
BOLT_LLM_PROVIDER=openai

# What to try if the preferred provider fails
# openai | xai | none
BOLT_LLM_FALLBACK=openai

# API keys
# Get OpenAI key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Get xAI key from: https://console.x.ai  (developer API bills separately from SuperGrok)
XAI_API_KEY=
# Google Gemini — used sparingly (opt-in only; prefer Grok/ChatGPT/Ollama)
# https://aistudio.google.com/apikey  (name must be exactly GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Titles: Grok/ChatGPT via BOLT_LLM_PROVIDER first. Gemini only if true.
USE_GEMINI_TITLES=false

# Nexus: Ollama (free) day-to-day; Grok when paid allowed; Gemini opt-in only.
# SuperGrok app sub ≠ free XAI_API_KEY. Use --paid or NEXUS_ALLOW_PAID=true for Grok API.
NEXUS_PREFERRED=ollama
NEXUS_ALLOW_PAID=false
NEXUS_USE_GEMINI=false
# NEXUS_TIMEOUT_SEC=45

# Optional model overrides
BOLT_OPENAI_MODEL=gpt-4o-mini
BOLT_XAI_MODEL=grok-4.5

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
TIKTOK_OPEN_ID=
TIKTOK_SCOPE=
TIKTOK_TOKEN_TYPE=

# YouTube Data API v3 (stats sync — read-only)
# python3 scripts/get_youtube_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/callback
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN_EXPIRES_AT=
YOUTUBE_SCOPE=
YOUTUBE_TOKEN_TYPE=

# Voice
Bolt_VOICE=Oliver (Enhanced)
Bolt_VOICE_MUTE=false
# Optional: ELEVENLABS_API_KEY=  ELEVENLABS_VOICE_ID=

# Creator manager / Amazon
AMAZON_ASSOCIATE_TAG=billycarter-20
CREATOR_PREFERRED_NAME=William
BOLT_REQUIRE_POST_APPROVAL=true

# Social handles (reference; tokens still per-platform)
TIKTOK_HANDLE=@itssimplybilly
TWITCH_CHANNEL=ItsSimplyBilly
YOUTUBE_HANDLE=@SimplyBilly
X_HANDLE=@SimplyBilly_
