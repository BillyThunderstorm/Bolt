# Bolt environment config template
# Copy to .env and fill in only the services you want to use.
# Never commit real API keys, tokens, passwords, or webhook URLs.

# OBS WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Twitch
TWITCH_CHANNEL=ThunderstormBilly
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_BOT_NAME=

# Streamlabs
STREAMLABS_SOCKET_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=
CAPTAIN_HOOK_WEBHOOK_URL=

# LLM provider selection
# openai  = use OpenAI (default, safe)
# xai     = use Grok via xAI
BOLT_LLM_PROVIDER=openai

# What to try if the preferred provider fails
# openai | xai | none
BOLT_LLM_FALLBACK=openai

# API keys
# Get OpenAI key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Get xAI key from: https://console.x.ai
XAI_API_KEY=

# Optional model overrides
BOLT_OPENAI_MODEL=gpt-4o-mini
BOLT_XAI_MODEL=grok-4.5

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
TIKTOK_OPEN_ID=
TIKTOK_SCOPE=
TIKTOK_TOKEN_TYPE=

# Voice
Bolt_VOICE=Oliver (Enhanced)
Bolt_VOICE_MUTE=false
# Optional: ELEVENLABS_API_KEY=  ELEVENLABS_VOICE_ID=

# Creator manager / Amazon
AMAZON_ASSOCIATE_TAG=billycarter-20
CREATOR_PREFERRED_NAME=William
BOLT_REQUIRE_POST_APPROVAL=true

# Social handles (reference; tokens still per-platform)
TIKTOK_HANDLE=@itssimplybilly
TWITCH_CHANNEL=thunderstormbilly
YOUTUBE_HANDLE=@SimplyBilly
X_HANDLE=@SimplyBilly_
