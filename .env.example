# Bolt environment config template
# Copy to .env and fill in only the services you want to use.
# Never commit real API keys, tokens, passwords, or webhook URLs.

# OBS WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Twitch
TWITCH_CHANNEL=ThunderstormBilly
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_BOT_NAME=

# Streamlabs
STREAMLABS_SOCKET_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=
CAPTAIN_HOOK_WEBHOOK_URL=

# Optional/legacy AI hooks
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk_your_key_here

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
TIKTOK_OPEN_ID=
TIKTOK_SCOPE=
TIKTOK_TOKEN_TYPE=

# Voice
Bolt_VOICE=Oliver (Enhanced)
Bolt_VOICE_MUTE=false
