# Bolt environment config template
# Copy to .env and fill in only the services you want to use.
# Never commit real API keys, tokens, passwords, or webhook URLs.

# OBS WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Twitch
TWITCH_CHANNEL=ItsSimplyBilly
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_TOKEN=
TWITCH_BOT_NAME=

# Streamlabs
STREAMLABS_SOCKET_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=
CAPTAIN_HOOK_WEBHOOK_URL=

# ── SuperGrok + light API (recommended for Bolt) ───────────────────────────
# SuperGrok ($~30/mo app/web) is for *you* chatting with Grok.
# XAI_API_KEY bills separately for Bolt automation at console.x.ai.
#
# BOLT_LLM_MODE:
#   local  = never call paid APIs (Ollama only)
#   light  = Grok API only for strategy/research/decisions (recommended)
#   full   = Grok API allowed for everyday chat too
BOLT_LLM_MODE=light

# Chat / conversation preferred provider (ollama keeps light-mode bills low)
# ollama | xai | openai
BOLT_LLM_PROVIDER=ollama
BOLT_LLM_FALLBACK=none

# API keys
OPENAI_API_KEY=
# https://console.x.ai  — required for Bolt to call Grok API
XAI_API_KEY=
# Google Gemini — opt-in only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Titles: keep free/local; Gemini only if true.
USE_GEMINI_TITLES=false

# Nexus: Ollama day-to-day; Grok for high-value when ALLOW_PAID=true
NEXUS_PREFERRED=ollama
# light plan: true so strategy/morning/research can use Grok API
NEXUS_ALLOW_PAID=true
NEXUS_USE_GEMINI=false
# NEXUS_TIMEOUT_SEC=45

# Models (flagship for hard thinking; light for medium; fast for titles)
BOLT_OPENAI_MODEL=gpt-4o-mini
BOLT_XAI_MODEL=grok-4.5
BOLT_XAI_MODEL_LIGHT=grok-4.3
BOLT_XAI_MODEL_FAST=grok-4.3
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Soft monthly API spend ceiling (USD). 0 = unlimited.
# When hit, Bolt forces Ollama until next calendar month (UTC).
BOLT_API_MONTHLY_CAP_USD=35

# Daily briefing Nexus path:
#   auto  = Grok for strategy when paid allowed + under cap (recommended)
#   grok  = always prefer Grok API for the briefing insight
#   local = always Ollama (never spend API on briefings)
BOLT_BRIEFING_PROVIDER=auto

# Budget alerts: SMS + email + Mac banner (Discord off)
BOLT_ALERT_SMS=true
BOLT_ALERT_EMAIL=true
BOLT_ALERT_MAC=true
BOLT_ALERT_DISCORD=false
# SMTP lives in Data/configs/storage_alerts.env (needed for SMS/email)

# Voice speech-to-text (bolt voice) — FREE by default
# google  = free Google Web Speech (recommended; no OpenAI bill)
# whisper = OpenAI Whisper API (PAID — requires credits + BOLT_USE_WHISPER=true)
BOLT_STT_PROVIDER=google
BOLT_USE_WHISPER=false

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=
TIKTOK_OPEN_ID=
TIKTOK_SCOPE=
TIKTOK_TOKEN_TYPE=

# YouTube Data API v3 (stats sync — read-only)
# python3 scripts/get_youtube_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/callback
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN_EXPIRES_AT=
YOUTUBE_SCOPE=
YOUTUBE_TOKEN_TYPE=

# Voice
Bolt_TTS_PROVIDER=macos
Bolt_VOICE=Voice 3
Bolt_VOICE_MUTE=false
# Optional: ELEVENLABS_API_KEY=  ELEVENLABS_VOICE_ID=

# Creator manager / Amazon
AMAZON_ASSOCIATE_TAG=billycarter-20
CREATOR_PREFERRED_NAME=William
BOLT_REQUIRE_POST_APPROVAL=true

# Social handles (reference; tokens still per-platform)
TIKTOK_HANDLE=@itssimplybilly
TWITCH_CHANNEL=ItsSimplyBilly
YOUTUBE_HANDLE=@SimplyBilly
X_HANDLE=@SimplyBilly_
