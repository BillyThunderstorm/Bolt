{
  "name": "get_memories",
  "description": "Retrieve stored memories, optionally filtered by category or importance",
  "args_schema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "description": "Filter by category (optional)"
      },
      "minImportance": {
        "type": "number",
        "description": "Minimum importance level (optional)"
      }
    }
  },
  "return_schema": {
    "type": "array",
    "items": { "type": "object" }
  }
}
